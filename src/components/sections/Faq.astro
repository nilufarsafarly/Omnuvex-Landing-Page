---
/**
 * FAQ: heading in the left 4 columns (sticky on desktop); questions as white cards in a mist
 * tray across 7 columns on the right. One answer open at a time, the first open by default;
 * clicking the open question closes it.
 */
import RevealTitle from '../ui/RevealTitle.astro';
import { faqs } from '../../data/faqs';
---

<section id="faq" class="ox-faq relative z-1 pt-16 pb-24 md:pt-24 md:pb-32" aria-labelledby="faq-title">
  <div class="ox-faq-wrap mx-auto grid max-w-page grid-cols-12 gap-x-6 px-[18px] md:px-8">
    <div class="ox-faq-head col-span-full lg:col-span-4">
      <RevealTitle
        id="faq-title"
        text="Frequently asked questions"
        class="ox-faq-h static m-0 text-title-sm font-semibold text-ink md:text-title lg:sticky lg:top-(--stick-top)"
      />
    </div>
    <ul
      class="ox-faq-list col-span-full m-0 mt-8 flex list-none flex-col gap-2 rounded-md bg-mist p-2 md:mt-10 lg:col-span-7 lg:col-start-6 lg:mt-0"
      data-faq
    >
      {
        faqs.map((f, i) => {
          const n = i + 1;
          const open = i === 0;
          return (
            <li class:list={['ox-faq-item rounded-md bg-white', open && 'is-open']}>
              <h3 class="ox-faq-q m-0">
                <button
                  class="ox-faq-btn flex w-full cursor-pointer items-center justify-between gap-6 rounded-md border-0 bg-transparent p-5 text-left text-[18px] leading-[26px] font-medium md:px-8 md:py-7 md:text-heading"
                  type="button"
                  id={`faq-q${n}`}
                  aria-expanded={open ? 'true' : 'false'}
                  aria-controls={`faq-a${n}`}
                >
                  {f.q}
                  <span class="ox-faq-ico relative size-10 flex-none rounded-sm bg-mist text-ink" aria-hidden="true"></span>
                </button>
              </h3>
              <div class="ox-faq-a" id={`faq-a${n}`} role="region" aria-labelledby={`faq-q${n}`}>
                <div class="ox-faq-a-in overflow-hidden">
                  <p class="m-0 px-5 pt-0 pb-6 text-body-sm text-secondary md:pr-24 md:pb-8 md:pl-8 md:text-body">{f.a}</p>
                </div>
              </div>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .ox-faq-btn {
    color: var(--color-ink);
    transition: color var(--dur-hover) var(--ease-standard);
  }
  .ox-faq-btn:hover {
    color: var(--color-action);
  }
  .ox-faq-btn:focus-visible {
    outline: 2px solid var(--color-action);
    outline-offset: -2px;
  }

  /* Plus that turns into a minus: the vertical bar rotates flat when the item opens */
  .ox-faq-ico::before,
  .ox-faq-ico::after {
    content: '';
    position: absolute;
    top: 19px;
    left: 13px;
    width: 14px;
    height: 1.5px;
    border-radius: 1px;
    background: currentColor;
    transition: transform 300ms var(--ease-standard);
  }
  .ox-faq-ico::after {
    transform: rotate(90deg);
  }
  .is-open .ox-faq-ico::after {
    transform: rotate(0deg);
  }

  /* Answer: height animates via grid rows, text fades in after it */
  .ox-faq-a {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 350ms var(--ease-standard);
  }
  .is-open .ox-faq-a {
    grid-template-rows: 1fr;
  }
  .ox-faq-a p {
    opacity: 0;
    transition: opacity 200ms ease;
  }
  .is-open .ox-faq-a p {
    opacity: 1;
    transition: opacity 300ms ease 100ms;
  }

  @media (prefers-reduced-motion: reduce) {
    .ox-faq-a,
    .ox-faq-a p,
    .is-open .ox-faq-a p,
    .ox-faq-ico::before,
    .ox-faq-ico::after {
      transition: none;
    }
  }
</style>

<script>
  const list = document.querySelector<HTMLElement>('[data-faq]');
  if (list) {
    const items = Array.from(list.querySelectorAll<HTMLLIElement>('.ox-faq-item'));
    // index of the open item; -1 = all closed
    let open = Math.max(
      -1,
      items.findIndex((it) => it.classList.contains('is-open')),
    );

    const render = () => {
      items.forEach((item, j) => {
        const isOpen = j === open;
        item.classList.toggle('is-open', isOpen);
        item.querySelector('.ox-faq-btn')?.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      });
    };

    items.forEach((item, i) => {
      item.querySelector('.ox-faq-btn')?.addEventListener('click', () => {
        open = open === i ? -1 : i;
        render();
      });
    });
  }
</script>
