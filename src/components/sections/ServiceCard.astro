---
/**
 * One services card. Desktop: accordion panel (narrow with title + "Open", or wide with the
 * full text when .is-active; Services.astro's script moves .is-active). Tablet: full card in a
 * 2-column grid. Phone: no icon, number on the title line, sticky stacking cards (scroll.ts
 * sets the transform). The line drawing and icon are picked by index, as in the canvas.
 */
type Props = {
  index: number;
  num: string;
  title: string;
  text: string;
  active?: boolean;
};

const { index, num, title, text, active = false } = Astro.props;
---

