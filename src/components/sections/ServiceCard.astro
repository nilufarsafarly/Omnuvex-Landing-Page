<style>
  /* ---------- Phone (< 768): full card, no icon, number on the title line; sticky stacking ---------- */
  .ox-svc {
    position: sticky;
    top: var(--stick-top);
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: 16px;
    align-items: baseline;
    min-width: 0;
    margin: 0;
    padding: 24px;
    background: var(--color-white);
    border: 0;
    border-radius: var(--radius-md);
    overflow: hidden;
    box-sizing: border-box;
    transform-origin: 50% 0;
    will-change: transform;
  }
  /* each next card sticks 12px lower and slides over the one before */
  .ox-svc:nth-of-type(2) {
    top: calc(var(--stick-top) + 12px);
  }
  .ox-svc:nth-of-type(3) {
    top: calc(var(--stick-top) + 24px);
  }
  .ox-svc:nth-of-type(4) {
    top: calc(var(--stick-top) + 36px);
  }

  .ox-svc-top,
  .ox-svc-full {
    display: contents;
  }

  .ox-svc-ico {
    display: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-sm);
    background: var(--color-ink);
    color: var(--color-white);
    transition: background-color 600ms var(--ease-emphasis);
  }

  .ox-svc-num {
    grid-column: 2;
    grid-row: 2;
  }

  /* Isometric line drawing, centred above the text */
  .ox-svc-artwrap {
    position: static;
    grid-column: 1 / -1;
    grid-row: 1;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    width: 100%;
    max-width: 240px;
    height: 180px;
    margin: 0 auto 32px;
    opacity: 0.7;
  }
  .ox-svc-art {
    display: block;
    width: 100%;
    height: 100%;
  }
  .ox-svc-art :global(*) {
    vector-effect: non-scaling-stroke;
  }
  /* The stacked-layers drawing is visually heavier: scale it down so all four read the same size */
  .ox-svc-art-dense {
    width: 80%;
    height: 80%;
  }

  .ox-svc-full h3 {
    grid-column: 1;
    grid-row: 2;
  }
  .ox-svc-full p {
    grid-column: 1 / -1;
    grid-row: 3;
  }

  .ox-svc-mini,
  .ox-svc-open,
  .ox-svc-hit {
    display: none;
  }

  /* ---------- Tablet (768–1023): every card shows its text, 2-column grid ---------- */
  @media (width >= 48rem) {
    .ox-svc,
    .ox-svc:nth-of-type(n) {
      position: relative;
      top: auto;
      z-index: auto;
      display: block;
      transform-origin: 50% 50%;
      will-change: auto;
    }
    .ox-svc-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .ox-svc-ico {
      display: flex;
    }
    .ox-svc-artwrap {
      margin: 32px auto 0;
    }
    .ox-svc-full {
      display: block;
      margin-top: 48px;
    }
  }

  /* ---------- Desktop (>= 1024): auto-rotating accordion, the open card is wide ---------- */
  @media (width >= 64rem) {
    .ox-svc {
      flex: 1 1 0;
      padding: 0;
      transition: flex-grow 900ms var(--ease-emphasis);
    }
    .ox-svc.is-active {
      flex-grow: 2.6;
    }
    .ox-svc:not(.is-active):hover .ox-svc-open {
      color: var(--color-ink);
    }

    .ox-svc-top {
      position: absolute;
      z-index: 1;
      top: 24px;
      left: 24px;
      right: 24px;
    }
    .ox-svc.is-active .ox-svc-ico {
      background: var(--color-action);
    }

    /* Drawing from the bottom-right corner, bleeding off both edges; inner edges fade out */
    .ox-svc-artwrap {
      position: absolute;
      bottom: -28px;
      right: -40px;
      width: 230px;
      max-width: none;
      height: 230px;
      margin: 0;
      justify-content: flex-end;
      opacity: 0.5;
      -webkit-mask-image: linear-gradient(to top, #000 55%, transparent), linear-gradient(to left, #000 60%, transparent);
      -webkit-mask-composite: source-in;
      mask-image: linear-gradient(to top, #000 55%, transparent), linear-gradient(to left, #000 60%, transparent);
      mask-composite: intersect;
      transition:
        bottom 900ms var(--ease-emphasis),
        right 900ms var(--ease-emphasis),
        width 900ms var(--ease-emphasis),
        height 900ms var(--ease-emphasis);
    }
    .ox-svc.is-active .ox-svc-artwrap {
      bottom: -40px;
      right: -56px;
      width: 420px;
      height: 400px;
    }

    /* Closed card: title + "Open" at the bottom */
    .ox-svc-mini {
      display: block;
      position: absolute;
      z-index: 1;
      left: 24px;
      right: 24px;
      bottom: 24px;
      transition: opacity 500ms var(--ease-out) 400ms;
    }
    .ox-svc.is-active .ox-svc-mini {
      opacity: 0;
      visibility: hidden;
      transition:
        opacity 300ms var(--ease-emphasis),
        visibility 0s linear 300ms;
    }
    .ox-svc-open {
      display: flex;
      color: var(--color-secondary);
    }

    /* Open card: big title + text */
    .ox-svc-full {
      position: absolute;
      z-index: 1;
      left: 24px;
      bottom: 24px;
      width: 420px;
      margin-top: 0;
      opacity: 0;
      visibility: hidden;
      transform: translateY(24px);
      transition:
        opacity 300ms var(--ease-emphasis),
        transform 300ms var(--ease-emphasis),
        visibility 0s linear 300ms;
    }
    .ox-svc.is-active .ox-svc-full {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition:
        opacity 700ms var(--ease-out) 450ms,
        transform 1000ms var(--ease-out) 450ms,
        visibility 0s;
    }

    /* The whole closed card is the button */
    .ox-svc-hit {
      display: block;
      position: absolute;
      inset: 0;
      z-index: 2;
      width: 100%;
      padding: 0;
      background: transparent;
      border: 0;
      border-radius: var(--radius-md);
      cursor: pointer;
    }
    .ox-svc.is-active .ox-svc-hit {
      display: none;
    }
    .ox-svc-hit:focus-visible {
      outline: 2px solid var(--color-action);
      outline-offset: -2px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ox-svc,
    .ox-svc-ico,
    .ox-svc-artwrap,
    .ox-svc-mini,
    .ox-svc.is-active .ox-svc-mini,
    .ox-svc-full,
    .ox-svc.is-active .ox-svc-full {
      transition: none;
    }
  }
</style>
