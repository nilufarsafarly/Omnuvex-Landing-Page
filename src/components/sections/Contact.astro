    </div>
    <AuditForm />
  </div>
</section>

<style>
  /* What happens next: a vertical timeline. Dashed rail like the illustrations; today's node is orange */
  .ox-contact-line::before {
    content: '';
    position: absolute;
    top: 8px;
    bottom: 30px;
    left: 5px;
    border-left: 1px dashed var(--color-grey-300);
  }
  .ox-contact-line li::before {
    content: '';
    position: absolute;
    top: 4px;
    left: -28px;
    width: 9px;
    height: 9px;
    box-sizing: content-box; /* canvas has no box-sizing reset: 9px + 1px border = 11px node */
    border-radius: 50%;
    background: var(--color-white);
    border: 1px solid var(--color-grey-400);
  }
  .ox-contact-line li.is-now::before {
    background: var(--color-orange);
    border-color: var(--color-orange);
    box-shadow: var(--shadow-now);
  }
  .ox-contact-line li.is-done::before {
    background: var(--color-ink);
    border-color: var(--color-ink);
  }
  .ox-contact-when {
    color: var(--color-secondary);
  }
  .is-now .ox-contact-when {
    color: var(--color-action);
  }
  .ox-contact-what {
    color: var(--color-ink);
  }
  .is-done .ox-contact-what {
    color: var(--color-secondary);
    text-decoration: line-through;
    text-decoration-color: var(--color-grey-400);
  }

  /* Isometric line drawing (message, Omnuvex unit, plan) from the bottom-right, fading in from the top and left */
  .ox-contact-artwrap {
    display: none;
    position: absolute;
    right: -16px;
    bottom: -8px;
    -webkit-mask-image: linear-gradient(to top, #000 60%, transparent), linear-gradient(to left, #000 65%, transparent);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(to top, #000 60%, transparent), linear-gradient(to left, #000 65%, transparent);
    mask-composite: intersect;
    pointer-events: none;
  }
  .ox-contact-art {
    display: block;
    width: 100%;
    height: auto;
  }
  .ox-contact-art * {
    vector-effect: non-scaling-stroke;
  }

  @media (width >= 48rem) {
    .ox-contact-artwrap {
      display: block;
      width: 300px;
      opacity: 0.5;
    }
  }
  @media (width >= 64rem) {
    .ox-contact-artwrap {
      width: min(440px, 58%);
      opacity: 0.75;
    }
  }
</style>

<script>
  // The audit form reports sent / reset; the timeline moves "now" from step 1 to step 2 and back.
  const steps = Array.from(document.querySelectorAll<HTMLLIElement>('[data-audit-timeline] > li'));
  document.addEventListener('ox:audit', (e) => {
    const sent = (e as CustomEvent<{ sent: boolean }>).detail.sent;
    const [first, second] = steps;
    first?.classList.toggle('is-done', sent);
    first?.classList.toggle('is-now', !sent);
    second?.classList.toggle('is-now', sent);
  });
</script>
