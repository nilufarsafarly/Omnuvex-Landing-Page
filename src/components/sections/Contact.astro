---
/**
 * Contact: on the page grid (1280 container, 12 columns, 24px gutter). Left 6 columns: pitch,
 * "what happens next" timeline and email note over an isometric line drawing. Right 6 columns:
 * the audit form card. Phone: timeline and drawing hidden; the info column dissolves into the
 * section grid (display: contents) so the "Prefer email?" note can be ordered after the form.
 */
import RevealTitle from '../ui/RevealTitle.astro';
import AuditForm from './AuditForm.astro';
import { timeline } from '../../data/form';
---

<section id="audit" class="ox-contact relative z-1 pt-16 pb-24 md:pt-24 md:pb-32" aria-labelledby="contact-title">
  <div class="ox-contact-tray mx-auto grid max-w-page grid-cols-12 items-stretch gap-x-6 px-[18px] md:px-8">
    <div
      class="ox-contact-info col-span-full contents *:col-span-full md:relative md:flex md:min-w-0 md:flex-col md:items-start md:overflow-hidden md:p-0 lg:col-span-6"
    >
      <RevealTitle
        id="contact-title"
        text="Ready to digitalize and automate your business?"
        class="ox-contact-h m-0 max-w-[560px] text-title-sm font-semibold text-ink md:text-title"
      />
      <p class="ox-contact-sub mt-5 mb-0 max-w-[480px] text-body-sm text-secondary md:text-body">
        Book a free audit and see where automation moves the needle first.
      </p>
      <ol
        class="ox-contact-line relative z-1 m-0 mt-10 hidden list-none flex-col gap-6 p-0 pl-7 md:flex"
        aria-label="What happens after you send the form"
        data-audit-timeline
      >
        {
          timeline.map((t, i) => (
            <li class:list={['relative flex flex-col gap-0.5', i === 0 && 'is-now']}>
              <span class="ox-contact-when text-caption font-medium">{t.when}</span>
              <span class="ox-contact-what text-[17px] leading-[26px] font-medium">{t.what}</span>
            </li>
          ))
        }
      </ol>
      <p class="ox-contact-note relative z-1 order-1 m-0 pt-6 text-caption text-secondary md:order-none md:mt-auto md:pt-8 lg:pt-10">
        Prefer email? Write to <a class="text-ink underline underline-offset-3" href="mailto:hello@omnuvex.com">hello@omnuvex.com</a>
      </p>
