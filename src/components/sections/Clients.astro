---
/**
 * Trusted by: one-line statement, five client logos in a mist tray. Logos are ink; hover
 * swaps in the brand colours. Desktop: one row spaced evenly in a 160px tray. Below 1024px:
 * one line that never wraps, logos scaled down and allowed to shrink.
 */
import { clients } from '../../data/clients';
---

<section id="clients" class="ox-trust relative z-1 pb-16 md:pb-24" aria-labelledby="trust-title">
  <div class="ox-trust-wrap mx-auto box-border max-w-page px-[18px] md:px-8">
    <div class="ox-trust-head flex flex-col items-start gap-4 lg:flex-row lg:items-center lg:justify-between lg:gap-8">
      <h2 id="trust-title" class="ox-trust-h m-0 max-w-[640px] text-[16px]/[22px] font-normal text-secondary md:text-[17px]/[24px]">
        Trusted by growing businesses across Real Estate, Wholesale &amp; Distribution, E-commerce and more.
      </h2>
    </div>
    <ul class="ox-trust-tray mt-8 flex list-none flex-nowrap items-center justify-between gap-3 rounded-md bg-mist px-4 py-8 md:gap-6 md:px-8 md:py-10 lg:h-[160px] lg:justify-evenly lg:gap-8 lg:py-0">
      {
        clients.map((c) => (
          <li
            class="ox-logo"
            style={`transform: translateY(${c.shift}px); --h-phone: ${c.height.phone}px; --h-tablet: ${c.height.tablet}px; --h-desktop: ${c.height.desktop}px`}
          >
            <img class="ox-logo-ink" src={c.ink} alt={c.name} />
            <img class="ox-logo-color" src={c.color} alt="" aria-hidden="true" />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* Logos sized by visual weight (equal optical area, heavier marks smaller) */
  .ox-logo {
    --h: var(--h-phone);
    position: relative;
    display: flex;
    flex: 0 1 auto;
    align-items: center;
    justify-content: center;
    min-width: 0;
    height: var(--h);
  }
  .ox-logo img {
    display: block;
    width: auto;
    max-width: 100%;
    height: var(--h);
    object-fit: contain;
    transition: opacity 400ms var(--ease-emphasis);
  }
  .ox-logo-color {
    position: absolute;
    inset: 0;
    margin: auto;
    opacity: 0;
  }
  .ox-logo:hover .ox-logo-color {
    opacity: 1;
  }
  .ox-logo:hover .ox-logo-ink {
    opacity: 0;
  }

  @media (width >= 48rem) {
    .ox-logo {
      --h: var(--h-tablet);
    }
  }

  @media (width >= 64rem) {
    .ox-logo {
      --h: var(--h-desktop);
      min-width: auto;
    }
    .ox-logo img {
      max-width: 180px;
    }
  }
</style>
